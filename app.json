{
  "expo": {
    "name": "时念",
    "slug": "sena",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sena",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.sena.mobile",
      "entitlements": {
        "com.apple.security.application-groups": ["group.app.sena.mobile"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#EEF2FF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "app.sena.mobile",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#6366F1",
          "sounds": []
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "时念需要访问你的日历来同步纪念日。",
          "remindersPermission": "时念需要访问你的提醒事项来同步纪念日。"
        }
      ],
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.app.sena.mobile",
          "bundleIdentifier": "app.sena.mobile.widgets",
          "widgets": [
            {
              "name": "SenaWidget",
              "displayName": "时念",
              "description": "在桌面查看即将到来的纪念日倒计时",
              "supportedFamilies": ["systemSmall", "systemMedium", "systemLarge"]
            }
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#EEF2FF"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
